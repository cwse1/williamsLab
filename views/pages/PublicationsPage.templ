package pages

import (
	"williamsLab/views/layouts"
	"williamsLab/models"
	"williamsLab/utils"
)

templ title(title string, pmid string, abstract string) {
	if abstract != "" {
		<b><a class="hover:underline" href={ "/publications/" + pmid }>{ title }</a></b>
	} else {
		<b>{ title }</b>
	}
}

templ date(d models.Date) {
	if d.Day != "01" {
		{ d.Year + " " + d.Month + " " + d.Day }
	} else {
		{ d.Year + " " + d.Month }
	}
}

templ pubListDisplay(pub models.Publication) {
	@title(pub.Title, pub.PMID, pub.Abstract)
	<p>
		{ pub.Journal } { pub.Issue }
		<span>
			<i>
				(
				@date(utils.ParseDate(pub.Date))
				)
			</i>
		</span>
		<a href={ "https://doi.org/" + pub.DOI } target="_blank" class="underline">{ pub.DOI }</a>
	</p>
}

templ PublicationsPage(pubsDB []models.Publication) {
	@layouts.BaseLayout("Publications") {
		<hr class="my-6"/>
		<div class="mb-6">
			preamble
		</div>
		<ul class="">
			for _, pub := range pubsDB {
				<li class="my-4">
					@pubListDisplay(pub)
				</li>
			}
		</ul>
	}
}
