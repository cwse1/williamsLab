package pages

import (
	"williamsLab/views/layouts"
	"williamsLab/models"
	"williamsLab/utils"
)

templ pubListDisplay(pub models.Publication) {
	<b><a class="hover:underline" hx-get={ "/publications/" + pub.PMID } hx-target="#contents" hx-push-url={ "/publications/" + pub.PMID } href={ "/publications/" + pub.PMID }>{ pub.Title }</a></b>
	<p>{ pub.Authors }</p> { pub.Journal }
	<a href={ "https://doi.org/" + pub.DOI } target="_blank" class="underline">{ pub.DOI }</a>{ " " }
	{ utils.ParseDate(pub.Date).Year }
}

templ PublicationsPage(pubsDB []models.Publication) {
	@layouts.BaseLayout("Publications") {
		<hr class="my-6"/>
		<div class="mb-6">
			preamble
		</div>
		<ul class="">
			for _, pub := range pubsDB {
				<li>
					@pubListDisplay(pub)
				</li>
			}
		</ul>
	}
}
