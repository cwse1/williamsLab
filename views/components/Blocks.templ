package components

import (
	"williamsLab/utils"

	"github.com/pocketbase/pocketbase/core"
)

templ text(text string) {
	@utils.ParseHTML(text)
}

templ image(rec *core.Record) {
	<img src={ "/api/files/" + rec.Collection().Id + "/" + rec.Id + "/" + rec.GetString("image") }/>
}

templ imageLeft(rec *core.Record) {
	<div>
		@image(rec)
	</div>
	<div>
		@text(rec.GetString("content"))
	</div>
}

templ imageRight(rec *core.Record) {
	<div>
		@text(rec.GetString("content"))
	</div>
	<div>
		@image(rec)
	</div>
}

templ heading(text string) {
	<h1 id={ text[:5] }>{ text }</h1>
}

func Block(rec *core.Record) templ.Component {
	if rec.Get("type") == nil {
		return heading(rec.GetString("topic"))
	}
	switch rec.GetString("type") {
	case "text":
		return text(rec.GetString("content"))
	case "image":
		return image(rec)
	case "imageLeft":
		return imageLeft(rec)
	case "imageRight":
		return imageRight(rec)
	}
	return nil
}
